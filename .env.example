EMBY_ID=
EMBY_SECRET=
EMBY_API_TOKEN=
EMBY_BASE_URL=

# Voice-upload live tests only. A scratch S3 bucket the tests may write into —
# the SDK never reads these, they are handed to the tenant via PUT /s3-credentials
# at the start of the suite. Left empty, the suite can only check that the backend
# refuses to issue an upload URL.
TEST_S3_ACCESS_KEY=
TEST_S3_SECRET_KEY=
TEST_S3_ENDPOINT_URL=
TEST_S3_BUCKET=

# Optional, same meaning as in PUT /s3-credentials.
TEST_S3_REGION=
TEST_S3_PATH_STYLE=
TEST_S3_PUBLIC_URL=
TEST_S3_CDN_URL=